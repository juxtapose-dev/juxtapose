{
  "name": "example-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Storybook example workbench for juxtapose.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build --quiet --disable-telemetry --loglevel error -o storybook-static",
    "jux": "jux",
    "visual": "storybook build --quiet --disable-telemetry --loglevel error -o storybook-static && jux run --all"
  },
  "dependencies": {
    "example-components": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@juxtapose/cli": "workspace:*",
    "@juxtapose/storybook": "workspace:*",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "msw": "2.15.0",
    "storybook": "^8.4.7",
    "vite": "^5.4.11"
  }
}
