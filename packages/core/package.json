{
  "name": "@juxtapose/core",
  "version": "0.23.0",
  "type": "module",
  "description": "Platform-agnostic capture, diff, baseline and analysis core for juxtapose.",
  "keywords": [
    "visual-regression",
    "screenshot-testing",
    "cdp",
    "visual-testing",
    "pixelmatch"
  ],
  "homepage": "https://github.com/juxtapose-dev/juxtapose/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.2.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser/index.js",
    "./format": "./dist/report/format.js",
    "./vite": "./dist/analysis/vite-plugin.js",
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-schema.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "devtools-protocol": "0.0.1653615",
    "pixelmatch": "6.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/pixelmatch": "^5.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juxtapose-dev/juxtapose.git",
    "directory": "packages/core"
  }
}
