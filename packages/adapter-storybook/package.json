{
  "name": "@juxtapose/adapter-storybook",
  "version": "0.2.0",
  "type": "module",
  "description": "Storybook platform adapter for juxtapose visual testing.",
  "keywords": [
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "testing",
    "storybook"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
