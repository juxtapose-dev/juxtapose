  },
  "dependencies": {
    "@juxtapose/core": "workspace:*"
  },
  "peerDependencies": {
    "playwright": "^1.48.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juxtapose-dev/juxtapose.git",
    "directory": "packages/adapter-storybook"
  },
  "peerDependenciesMeta": {
