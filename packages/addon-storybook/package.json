{
  "name": "@juxtapose/storybook",
  "version": "0.2.0",
  "type": "module",
  "description": "Storybook addon for juxtapose — review visual diffs next to the story that produced them.",
  "keywords": [
    "storybook-addon",
    "test",
    "storybook",
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "testing",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./manager": "./manager.js",
    "./preset": "./preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "manager.js",
    "preset.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@juxtapose/core": "workspace:*",
    "@juxtapose/server": "workspace:*",
    "@juxtapose/adapter-storybook": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "storybook": "^8 || ^9 || ^10"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "storybook": "^8.4.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juxtapose-dev/juxtapose.git",
    "directory": "packages/addon-storybook"
  },
  "storybook": {
    "displayName": "Juxtapose"
  }
}
