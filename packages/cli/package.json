{
  "name": "@juxtapose/cli",
  "version": "0.18.0",
  "type": "module",
  "description": "jux — visual regression testing CLI for Storybook, Ladle and friends.",
  "keywords": [
    "visual-regression",
    "screenshot-testing",
    "storybook",
    "ladle",
    "cli",
    "visual-testing"
  ],
  "homepage": "https://github.com/juxtapose-dev/juxtapose#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "jux": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.2.0"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs"
  },
  "dependencies": {
    "@juxtapose/core": "workspace:*",
    "@juxtapose/adapter-ladle": "workspace:*",
    "@juxtapose/adapter-storybook": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juxtapose-dev/juxtapose.git",
    "directory": "packages/cli"
  }
}
