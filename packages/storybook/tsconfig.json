{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Manager code: Storybook provides only react/react-dom as globals, so the
    // automatic runtime (react/jsx-runtime) would be bundled from the project's
    // own React and crash on a version mismatch (#198). Classic emits
    // React.createElement against the global `react` import instead.
    "jsx": "react",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "../core" }, { "path": "../server" }]
}
