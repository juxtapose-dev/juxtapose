{
  "name": "@juxtapose/storybook",
  "version": "0.9.4",
  "type": "module",
  "description": "Storybook addon for juxtapose — review visual diffs next to the story that produced them.",
  "keywords": [
    "storybook",
    "storybook-addon",
    "visual-regression",
    "screenshot-testing",
    "visual-testing",
    "storybook-addons"
  ],
  "homepage": "https://github.com/juxtapose-dev/juxtapose#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./manager": "./manager.js",
    "./preset": "./preset.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "files": [
    "dist",
    "manager.js",
    "preset.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@juxtapose/core": "workspace:*",
    "@juxtapose/server": "workspace:*",
    "@juxtapose/adapter-storybook": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "storybook": "^8 || ^9 || ^10"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "storybook": "^8.4.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juxtapose-dev/juxtapose.git",
    "directory": "packages/storybook"
  }
}
