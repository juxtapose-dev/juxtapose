    "chakra": {
      "maxWallSeconds": 2400,
      "allowedErrors": [],
      "knownVariable": [
        "components-card--basic",
        "layout-aspectratio--map",
        "foundations-sandbox--re-renders",
        "components-avatar--store",
        "rich-text-editor-tiptap--composition",
        "components-rating--testimonial",
        "components-timeline--sizes"
      ],
      "concurrency": 2
    },
    "primer": {
      "maxWallSeconds": 2400,
      "allowedErrors": ["components-treeview-features--contain-intrinsic-size"],
      "knownVariable": [
        "components-relativetime-features--count-down-timer",
        "components-avatar-features--size-responsive",
        "components-avatar-features--size"
      ],
      "concurrency": 2
    },
    "spectrum": {
      "maxWallSeconds": 2400,
      "allowedErrors": [],
      "knownVariable": [
        "coachmark--with-gif",
        "overlay--defined-overlay-element",
        "overlay--click-content-closed-on-scroll",
        "overlay-element--page",
        "overlay--complex-modal",
        "dialog-base--fully-custom",
        "dialog-base--not-again",
        "dialog-wrapper--form",
        "dialog-wrapper--tooltips",
        "tabs--default",
        "color-slider--image",
        "overlay-element--hover-tooltip",
        "card--default",
        "dialog-base--slotted",
        "overlay-element--action-group"
      ],
      "concurrency": 2
    }
  }
}
